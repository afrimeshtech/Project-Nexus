# Production settings for deploy/docker-compose.yml.
# Copy to deploy/.env on the server and fill in the blanks. Never commit .env.

# --- Domain and HTTPS --------------------------------------------------------
SITE_DOMAIN=afrimeshcommerce.com
SITE_URL=https://afrimeshcommerce.com

# --- Database ----------------------------------------------------------------
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Payments ----------------------------------------------------------------
# mock: orders settle instantly, no money moves. Testing and the pitch.
# paystack: needs PAYSTACK_SECRET_KEY and the webhook set to
#   https://afrimeshcommerce.com/api/webhooks/paystack
PAYMENT_PROVIDER=mock
# PAYSTACK_SECRET_KEY=

# --- Sign-in codes -----------------------------------------------------------
# A production server never shows a code on screen. Phone codes are off until
# an SMS provider is added; email codes need Resend with this domain verified.
# Phone + password sign-up and sign-in work without either.
NOTIFICATION_TRANSPORT=console
EMAIL_TRANSPORT=console
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=
# EMAIL_FROM=AfriMesh <codes@afrimeshcommerce.com>

# --- Platform ----------------------------------------------------------------
PLATFORM_FEE_BPS=150
DEFAULT_CURRENCY=NGN
DEFAULT_COUNTRY=NG
RESERVATION_TTL_MINUTES=20
TERRITORY_MIN_ACTORS=1
RIDER_SHARE_BPS=8000
CASHBACK_BPS=50
POINT_VALUE_KOBO=100
MIN_REDEEMABLE_POINTS=500
REFERRAL_MIN_ORDER_KOBO=100000
